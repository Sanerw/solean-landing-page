# The RxScale questionnaire the funnel renders. Public: the anamnesis read and submit
# endpoints take no API key. This is the questionnaire solean.com renders today.
PUBLIC_RXSCALE_QUESTIONNAIRE_UID=4c06f07e-3319-4afd-9c78-ab0a2722db06

# Optional. Defaults are https://api.rxscale.com and /api/v3-1/anamnesis, the prefix
# RxScale's current snippet uses. /api/v2/anamnesis serves the same document; the
# documented /v4/anamnesis prefix does not answer yet.
# PUBLIC_RXSCALE_API_BASE_URL=https://api.rxscale.com
# PUBLIC_RXSCALE_ANAMNESIS_BASE_PATH=/api/v2/anamnesis

# The shop RxScale keys its product recommendation by. This is the storefront hostname, not
# the myshopify domain: solean.com is answered where mygina.myshopify.com is refused. Without
# it no recommendation is fetched and the order falls back to SHOPIFY_VARIANT_ID.
PUBLIC_RXSCALE_SHOP_IDENTIFIER=solean.com

# Optional. The recommendation lives on /api/v2/anamnesis and only there: /api/v3-1 answers
# the same request with an empty list, which would read as "nothing recommended".
# PUBLIC_RXSCALE_RECOMMENDATION_BASE_PATH=/api/v2/anamnesis
# PUBLIC_RXSCALE_LOCALE=de

# To develop against the local fixture instead of the live questionnaire, run
# `pnpm fixture:questionnaire` and set:
# PUBLIC_RXSCALE_API_BASE_URL=http://localhost:4319
# PUBLIC_RXSCALE_QUESTIONNAIRE_UID=fixture-questionnaire
# PUBLIC_RXSCALE_SHOP_IDENTIFIER=localhost:4319

# The checkout handoff, which is a Shopify Storefront cart carrying the anamnesis as the
# order attribute RxScale reads it off. None of these is a secret: the variant and the token
# are server-only so the variant stays out of the client bundle and validation has one home,
# while the domain is public because the checkout URL names the shop anyway. Without the
# domain the order button reports that this deployment cannot order.
# PUBLIC_SHOPIFY_STORE_DOMAIN=mygina.myshopify.com

# The plan offered when RxScale recommends nothing, or cannot be reached. Every other order
# uses a variant from the recommendation, checked against it server-side.
# SHOPIFY_VARIANT_ID=49703544684877

# Optional. The shop answers without a token today, which is undocumented behaviour rather
# than a guarantee, so it is sent when set and its absence is not an error.
# SHOPIFY_STOREFRONT_TOKEN=<a Storefront API access token>

# Optional. Defaults to 2025-01.
# SHOPIFY_STOREFRONT_API_VERSION=2025-01

# To develop against the local fixture instead of the real shop, run
# `pnpm fixture:questionnaire` and set the domain to it. A scheme is accepted here; without
# one the domain is called over https.
# PUBLIC_SHOPIFY_STORE_DOMAIN=http://localhost:4319

# Sanity. The project and dataset are public: they name the content the site already serves,
# and the Studio in ../studio-solean uses the same pair. The API version is pinned rather than
# floating so a query cannot change behaviour without a code change.
PUBLIC_SANITY_PROJECT_ID=tzq5b2my
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-09-02

# Where the Presentation tool lives, for the click-to-edit overlays. `sanity dev` serves the
# Studio on 3333; point this at the deployed Studio once there is one.
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server only, and the one Sanity secret. It reads drafts, so preview mode is off without it
# and the site serves published content alone. Create one with Viewer access at
# https://sanity.io/manage/project/tzq5b2my/api. Must be declared even when empty: a `$env/static/private`
# import of an undeclared variable fails the build.
SANITY_API_READ_TOKEN=

# Optional. Empty everywhere except the browser test harness, which points it at the local
# fixture server so a test run never reads the live Content Lake.
PUBLIC_SANITY_API_HOST=

# Mixpanel. Public because a project token identifies the project to write into and nothing
# else; it grants no read access. Absent means this deployment does not measure, which is a
# valid state rather than an error. Nothing is ever sent without the visitor's consent.
PUBLIC_MIXPANEL_TOKEN=96ec37e4f6757c0944914110df63ce09

# Optional. Defaults to https://api-eu.mixpanel.com, the EU residency host. Set it to
# https://api.mixpanel.com only if the project is a US one; a token is rejected by the wrong
# region's host.
# PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
